{
	"$schema": "node_modules/wrangler/config-schema.json",
	"main": ".open-next/worker.js",
	"name": "mentifylabs",
	"compatibility_date": "2026-09-28", // CI/CD smoke test: verifying Workers Builds triggers on push.
	"compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
	"vars": {
		// Used in emailed links in production, so they never depend on the request's Host header.
		"SITE_URL": "https://mentifylabs.com",
		"MAIL_FROM": "MentifyLabs <no-reply@mentifylabs.com>"
		// RESEND_API_KEY is a secret: npx wrangler secret put RESEND_API_KEY
	},
	"assets": {
		"directory": ".open-next/assets",
		"binding": "ASSETS"
	},
	"services": [
		{
			"binding": "WORKER_SELF_REFERENCE",
			"service": "mentifylabs"
		}
	],
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "mentifylabs-db",
			// Production database (APAC). Local development ignores it and uses a SQLite file under .wrangler/.
			"database_id": "aa0d64a2-f415-4b88-94f3-36cdcac515a6",
			"migrations_dir": "migrations"
		},
		{
			// OpenNext tag cache: records when revalidatePath() marks a page as changed.
			"binding": "NEXT_TAG_CACHE_D1",
			"database_name": "mentifylabs-cache",
			"database_id": "054b48f9-3a01-4624-9067-56ee0d00bc08"
		}
	],
	"r2_buckets": [
		{
			// Profile photos (public, served at /media/...) and verification documents (private, /documents/<id>).
			"binding": "UPLOADS",
			"bucket_name": "mentifylabs-uploads"
		}
	],
	"kv_namespaces": [
		{
			// OpenNext incremental cache: the rendered HTML of pre-rendered pages (public profiles).
			"binding": "NEXT_INC_CACHE_KV",
			"id": "105305efb09244c1b5f51f134cba3fc1"
		}
	],

	// A fully separate set of resources — its own D1, R2 and KV, never production's.
	// No explicit "name" here, so Wrangler deploys it as "mentifylabs-staging"
	// (the "{name}-{environment}" default) — matching the WORKER_SELF_REFERENCE below.
	"env": {
		"staging": {
			"vars": {
				"SITE_URL": "https://staging.mentifylabs.com",
				"MAIL_FROM": "MentifyLabs (staging) <no-reply@mentifylabs.com>"
				// No RESEND_API_KEY secret on staging on purpose — emails log instead
				// of sending, the same as local dev, so testing here never emails a real person.
			},
			"services": [
				{
					"binding": "WORKER_SELF_REFERENCE",
					"service": "mentifylabs-staging"
				}
			],
			"d1_databases": [
				{
					"binding": "DB",
					"database_name": "mentifylabs-staging-db",
					"database_id": "13105051-89fa-4d24-b203-ee251db23761",
					"migrations_dir": "migrations"
				},
				{
					"binding": "NEXT_TAG_CACHE_D1",
					"database_name": "mentifylabs-staging-cache",
					"database_id": "c8db7d45-9b1e-4f1f-9cfb-61c837921fca"
				}
			],
			"r2_buckets": [
				{
					"binding": "UPLOADS",
					"bucket_name": "mentifylabs-staging-uploads"
				}
			],
			"kv_namespaces": [
				{
					"binding": "NEXT_INC_CACHE_KV",
					"id": "43c9686536fd418780ebe42190672c59"
				}
			]
		}
	}
}
