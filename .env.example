# Copy to .env.local for local development.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Currency pre-selected for new practitioners (they can change it). Must be one of the codes in src/lib/currencies.ts.
NEXT_PUBLIC_DEFAULT_CURRENCY=PKR
# Country used for hints like the example phone number. Optional: if unset it follows the default currency above. A code from src/lib/countries.ts.
NEXT_PUBLIC_DEFAULT_COUNTRY=PK
